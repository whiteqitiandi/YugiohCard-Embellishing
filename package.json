{
  "name": "arcana-archive",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first Yu-Gi-Oh! card archive and visual finishing studio prototype.",
  "main": "./out/main/index.js",
  "scripts": {
    "test": "node scripts/test-catalog-updates.mjs && npm run test:directory",
    "test:directory": "node --experimental-strip-types --test tests/directory-selection.test.ts",
    "catalog:reconcile": "node scripts/run-reconcile-catalog.mjs",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "opencc-js": "^1.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.0.0",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  }
}
